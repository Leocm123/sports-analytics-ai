# Copie este arquivo para ".env" (mesma pasta) e preencha os valores.
# O ".env" NUNCA deve ir para o Git — ele já está no .gitignore.

# Chave do dashboard.api-football.com (Account -> My Access)
APISPORTS_KEY=

# Parâmetros da competição
LEAGUE_ID=71
SEASON=2026

# API pública da ESPN (temporada atual). Opcional: os valores abaixo já são o
# padrão no config.py. Só descomente se precisar trocar a liga ou a URL.
# ESPN_BASE_URL=https://site.api.espn.com/apis
# ESPN_LEAGUE=bra.1

# Connection string do Neon (Dashboard -> Connect). Use o driver psycopg:
# postgresql+psycopg://usuario:senha@host.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Google AI Studio (Fase 3)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
